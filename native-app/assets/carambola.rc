1 ICON "@ICON_PATH@"

1 VERSIONINFO
FILEVERSION @VERSION_FIELDS@
PRODUCTVERSION @VERSION_FIELDS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Carambola native screenshot annotation app\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "OriginalFilename", "carambola-native.exe\0"
            VALUE "ProductName", "Carambola\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
