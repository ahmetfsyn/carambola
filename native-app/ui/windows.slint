import { Button } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    title: "Carambola — Native Screenshot Annotation";
    width: 760px;
    height: 520px;
    background: #0b1020;

    callback open-overlay();
    in property <string> status: "Ready — capture the primary display.";

    Rectangle {
        background: #0b1020;
        VerticalLayout {
            padding: 32px;
            spacing: 20px;

            Rectangle {
                height: 56px;
                background: transparent;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 10px;
                        height: 34px;
                        background: #27d7d0;
                        border-radius: 5px;
                    }
                    VerticalLayout {
                        Text {
                            text: "CARAMBOLA";
                            color: #e9f2ff;
                            font-size: 17px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Native screenshot capture and annotation";
                            color: #8491a8;
                            font-size: 12px;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: "PHASE 6";
                        color: #f1c75b;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #273149;
            }

            Text {
                text: "Screenshot annotation prototype";
                color: #f4f7fc;
                font-size: 25px;
                font-weight: 700;
            }
            Text {
                text: "Capture a desktop region, annotate with seven native tools, then save or copy the final image.";
                color: #aab6c9;
                font-size: 14px;
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
                background: #111a2b;
                border-color: #273149;
                border-width: 1px;
                border-radius: 14px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text { text: "Status"; color: #e9f2ff; font-size: 15px; font-weight: 650; }
                    Text { text: root.status; color: #aab6c9; font-size: 13px; wrap: word-wrap; }
                    Text { text: "Windows capture uses GDI BitBlt and returns physical-pixel RGBA."; color: #aab6c9; font-size: 12px; }
                    Text { text: "macOS capture is not implemented in this phase."; color: #f1c75b; font-size: 12px; }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button {
                    text: "Capture primary display";
                    clicked => { root.open-overlay(); }
                }
            }
        }
    }
}

